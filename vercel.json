{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/courtos/1120.ts": {
      "includeFiles": ".courtos-generated/foundation-a/**",
      "maxDuration": 30
    },
    "api/household/1120.ts": {
      "includeFiles": ".courtos-generated/foundation-a/**",
      "maxDuration": 30
    },
    "api/council-room/1120.ts": {
      "includeFiles": ".courtos-generated/foundation-a/**",
      "maxDuration": 30
    },
    "api/responsibilities/1120.ts": {
      "includeFiles": ".courtos-generated/foundation-a/**",
      "maxDuration": 30
    },
    "api/spatial/1120.ts": {
      "includeFiles": ".courtos-generated/foundation-a/**",
      "maxDuration": 30
    },
    "api/spatial/1120/visual.ts": {
      "includeFiles": [
        ".courtos-generated/foundation-a/**",
        "data/map/mapgen_exports/**"
      ],
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run courtos:build:production"
}
